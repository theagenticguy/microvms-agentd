{
  "name": "microvms-agentd-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The documentation site for microvms-agentd, built so an agent can read it without rendering it.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs && node scripts/gen-reference.mjs",
    "braces": "node scripts/brace-gate.mjs src/content/docs",
    "prebuild": "pnpm run sync && pnpm run braces",
    "build": "astro build",
    "predev": "pnpm run sync && pnpm run braces",
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "astro check",
    "gen:icons": "node src/branding/write-icons.ts",
    "test": "vitest run",
    "typecheck": "astro check",
    "lint": "biome check src tests scripts astro.config.ts vitest.config.ts vitest.a11y.config.ts cspell.json lighthouserc.json --no-errors-on-unmatched && pnpm run spellcheck",
    "spellcheck": "cspell --no-progress \"authored/**/*.md\" \"authored/**/*.mdx\"",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:budget": "CHROME_PATH=$(node -p 'require(\"playwright\").chromium.executablePath()') lhci autorun"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/starlight": "0.41.10",
    "@expressive-code/plugin-collapsible-sections": "0.44.1",
    "@expressive-code/plugin-line-numbers": "0.44.1",
    "astro": "7.2.9",
    "astro-og-canvas": "0.13.0",
    "beautiful-mermaid": "1.1.3",
    "canvaskit-wasm": "0.42.0",
    "satteri": "0.10.5",
    "starlight-base-path": "0.2.1",
    "starlight-links-validator": "0.25.3",
    "starlight-llms-txt": "0.11.0",
    "starlight-md-txt": "0.1.0",
    "starlight-scroll-to-top": "1.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@expo-google-fonts/tinos": "0.4.2",
    "@lhci/cli": "0.15.1",
    "@types/hast": "3.0.5",
    "@types/node": "26.4.0",
    "cspell": "10.2.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
