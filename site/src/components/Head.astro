---
// SPDX-License-Identifier: Apache-2.0
/**
 * Starlight's `<head>`, extended with four things it does not emit: the raster icons, this page's
 * social card, the block that points a machine reader at this page's raw Markdown route and at the
 * site's machine surfaces, and the JSON-LD graph that states the same relationship in a vocabulary a
 * different consumer reads.
 *
 * One component owns every machine hint on the page, which is what stops the canonical URL and the
 * JSON-LD `url` from disagreeing with nothing to catch it.
 *
 * Deliberately absent: `rel="describedby"`, which is the wrong relationship and has no adopters — not
 * even llmstxt.org itself; and any visually-hidden agent-directed block, which is content served to
 * machines and hidden from every human. That is cloaking wearing an accessibility class name.
 *
 * The icons and the card are emitted only because the build emits the files they name: `public/`
 * carries the four icons `src/branding/write-icons.ts` writes, and `src/pages/og/[...slug].png.ts`
 * renders one card per collection entry. A `<link>` or an `og:image` naming a file the build does not
 * emit is worse than the absent tag, because a crawler follows it and attributes the 404 here;
 * `tests/branding.test.ts` is what keeps the committed icons equal to the generator.
 *
 * Every URL is built with `new URL()`, never by concatenating strings. `Astro.site` EXCLUDES the base —
 * for this site it is `https://theagenticguy.github.io` — so resolving a path against it directly drops
 * the `/microvms-agentd` segment and yields a 404 that only appears in production.
 * `import.meta.env.BASE_URL` is the accessor that includes it.
 */
import Default from "@astrojs/starlight/components/Head.astro"

import { APPLE_TOUCH_SIZE, ICO_SIZES, ICON_PNG_SIZE } from "../branding/mark.js"
import { OG_HEIGHT, OG_WIDTH, ogAlt, ogSlug } from "../branding/og-card.js"
import { discoveryLinks, siteUrl } from "../lib/agent-surface.js"
import { jsonLdGraph, jsonLdText, type SiteDescription } from "../lib/jsonld.js"

/**
 * The site node, stated once.
 *
 * No `searchEndpoint`: Starlight's search is Pagefind, which runs entirely in the browser, so no GET
 * returns results and a `SearchAction` here would be a machine-readable claim that 404s on the first
 * consumer that follows it.
 */
const SITE: SiteDescription = {
  name: "microvms-agentd",
  description:
    "A verified client stack and in-VM daemon for AWS Lambda MicroVMs, in Rust: the wire protocol, " +
    "the trust boundary, and measured platform behavior.",
  inLanguage: "en",
  publisher: { name: "theagenticguy", url: "https://github.com/theagenticguy/microvms-agentd" }
}

const { site } = Astro
if (site === undefined) {
  throw new Error(
    "`site` is unset in astro.config.ts, so no absolute machine-surface URL can be built"
  )
}

const base = import.meta.env.BASE_URL
const context = { site, base }

const route = Astro.locals.starlightRoute
const { entry } = route

const links = discoveryLinks(entry.id, context)

/*
 * An icon is a same-site asset and stays root-relative, so a preview build served from another host
 * does not fetch its icons from production. `siteUrl` resolves under the base segment exactly as the
 * discovery links do, and only the pathname is read back out: still a URL resolution rather than a
 * concatenation, so the base segment can be neither doubled nor dropped.
 */
const asset = (file: string): string => siteUrl(file, context).pathname

/* `og:image` is the one URL that must be absolute: a crawler resolves it against nothing. */
const card = siteUrl(`og/${ogSlug(entry.id)}`, context)
const cardAlt = ogAlt(entry.data.title)

const icoSizes = ICO_SIZES.map((size) => `${size}x${size}`).join(" ")
const appleTouch = `${APPLE_TOUCH_SIZE}x${APPLE_TOUCH_SIZE}`

const graph = jsonLdGraph(
  {
    entryId: entry.id,
    title: entry.data.title,
    description: entry.data.description ?? SITE.description,
    /*
     * `lastUpdated` is Starlight's git-derived timestamp, present because `lastUpdated: true` is set in
     * the config. Omitted rather than defaulted when git has nothing to say — a synced page carries
     * `editUrl: false` and no history of its own, and an invented date is a fact the graph asserts.
     */
    ...(route.lastUpdated === undefined
      ? {}
      : { dateModified: route.lastUpdated.toISOString() })
  },
  SITE,
  context
)
---

{/*
  The raster icons come BEFORE the default head on purpose. Starlight sorts its own
  `<link rel="shortcut icon">` (the SVG) to the end so a browser choosing between equally applicable
  icons takes the SVG, which stays sharp at any scale; a PNG declared after it would win that choice
  instead. Ported from memhtml-public's Head.astro.
*/}
<link rel="icon" href={asset("favicon.ico")} sizes={icoSizes} />
<link
  rel="icon"
  type="image/png"
  href={asset(`icon-${ICON_PNG_SIZE}.png`)}
  sizes={`${ICON_PNG_SIZE}x${ICON_PNG_SIZE}`}
/>
<link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} sizes={appleTouch} />

{/* The default is delegated to, never replaced: replacing it drops the canonical link and the sitemap
    reference, and both are silent losses. */}
<Default {...Astro.props}><slot /></Default>

{/*
  Starlight emits `twitter:card: summary_large_image` and no image (read from its `utils/head.ts`), so
  these are additions and not a second `og:image` beside a default one.
*/}
<meta property="og:image" content={card.href} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={cardAlt} />
<meta name="twitter:image" content={card.href} />
<meta name="twitter:image:alt" content={cardAlt} />

{
  links.map((link) => (
    <link rel={link.rel} type={link.type} href={link.href} title={link.title} />
  ))
}

{/*
  `set:html` and never `{...}` interpolation, which would HTML-escape the JSON into `&quot;` entities
  that no `application/ld+json` parser accepts.

  `is:inline` is stated rather than inferred. Astro already treats a `<script>` carrying an attribute as
  inline, and says so as a hint on every `astro check` run; this is not JavaScript, so bundling it would
  be wrong as well as impossible. Declaring the intent silences a hint that would otherwise appear on
  every green run, and a warning that appears on every green run is a warning nobody reads.
*/}
<script is:inline type="application/ld+json" set:html={jsonLdText(graph)} />
