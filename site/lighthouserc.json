{
  "ci": {
    "collect": {
      "startServerCommand": "STATIC_PORT=4173 node --experimental-strip-types tests/static-server.ts",
      "startServerReadyPattern": "serving",
      "startServerReadyTimeout": 20000,
      "url": [
        "http://127.0.0.1:4173/microvms-agentd/",
        "http://127.0.0.1:4173/microvms-agentd/learn/tutorial/first-run/",
        "http://127.0.0.1:4173/microvms-agentd/reference/commands/run/",
        "http://127.0.0.1:4173/microvms-agentd/internals/platform/",
        "http://127.0.0.1:4173/microvms-agentd/internals/architecture/system-overview/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "optimistic"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 570000,
            "aggregationMethod": "pessimistic"
          }
        ],
        "unminified-css": "error",
        "unminified-javascript": "error"
      }
    }
  }
}
