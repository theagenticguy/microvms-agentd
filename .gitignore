# Matches at any depth: the model crate has its own target/ directory.
target/
Cargo.lock.orig
.erpaval/sessions/
# Terraform working state: the conformance stack is created and destroyed per
# run, so its state is never worth committing.
conformance/infra/.terraform/
conformance/infra/.terraform.lock.hcl
conformance/infra/terraform.tfstate*
# Python build and test artifacts from the client library.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
# The napi-rs build outputs. `napi build --platform` writes the compiled addon plus a
# generated loader and type declarations beside `package.json`; all three are derived from
# `microvms-js/src/` and are rebuilt by `npm run build`, so committing them would commit one
# platform's binary into a repo other platforms clone.
microvms-js/*.node
microvms-js/index.js
microvms-js/index.d.ts
microvms-js/node_modules/
