{
  "name": "microvms",
  "version": "0.1.0",
  "description": "Node bindings over microvms-core: the MicroVMs client with every trap closure",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "microvms"
  },
