{
  "name": "microvms",
  "version": "0.1.0",
  "description": "Node bindings over microvms-core: the MicroVMs client with every trap closure",
  "license": "Apache-2.0",
  "author": "Laith Al-Saadoon",
  "homepage": "https://theagenticguy.github.io/microvms-agentd/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theagenticguy/microvms-agentd.git",
    "directory": "microvms-js"
  },
  "bugs": {
    "url": "https://github.com/theagenticguy/microvms-agentd/issues"
  },
  "keywords": [
    "microvms",
    "lambda",
    "aws",
    "sandbox",
    "microvm",
    "napi-rs"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "microvms",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --manifest-path ../Cargo.toml --package microvms-js --platform --output-dir .",
    "test": "node --test __test__/*.mjs",
    "test:smoke": "node --test __test__/smoke.mjs",
    "test:unit": "node --test __test__/cost.mjs __test__/errors.mjs __test__/exec.mjs __test__/process.mjs __test__/session.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
